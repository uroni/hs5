{
  "name": "main",
  "version-string": "latest",
  "dependencies": [
    "folly",
    "proxygen",
    "zstd",
    "expat",
    "libsodium",
    "openssl",
    "sqlite-cpp-sqlgen",
    "nlohmann-json",
    "fmt",
    "argon2",
    "tclap",
    "aws-checksums",
    "aws-c-common",
    "frozen",
    "jemalloc"
  ],
  "default-features": [
    "duckdb"
  ],
  "features": {
    "duckdb": {
      "description": "DuckDB UI with access to hs5 objects",
      "dependencies": [
        {
         "name": "duckdb-custom",
         "features": ["autocomplete", "excel", "httpfs", "json", "tpcds", "tpch","ui","ducklake"]
        }
      ]
    }
  }
}
