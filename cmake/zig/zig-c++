#!/bin/sh
# zig only accepts its own CPU names for -march, so map arm architecture names
# (e.g. -march=armv8-a+crc+crypto from aws-checksums) to zig's generic CPU, keeping the features
for arg do
	shift
	case "$arg" in
		-march=armv8*-a*) arg="-march=generic${arg#-march=armv8*-a}" ;;
	esac
	set -- "$@" "$arg"
done
# zig turns -Wdate-time into an error in optimized builds (breaks e.g. duckdb's pcg)
exec "${ZIG:-zig}" c++ -target "$(uname -m)-linux-musl" -Wno-date-time "$@"
